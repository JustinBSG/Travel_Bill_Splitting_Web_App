// Cloudflare Workers (static assets only, no Worker script) for the PWA.
// Workers Builds runs `npm run build:cloudflare`, then `npx wrangler deploy`
// from web/ (see web/DEPLOY.md).
{
  // becomes https://travel-bill-splitting-web-app.<your-subdomain>.workers.dev
  "name": "travel-bill-splitting-web-app",
  "compatibility_date": "2026-09-01",
  // Serve Previews at https://<preview-name>-<worker>.<subdomain>.workers.dev
  // (e.g. uat-…). Worker-level setting: applied by `wrangler deploy` on main,
  // or switch it on in Settings -> Domains & Routes.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // client-side routes (/join/<token>, /trips/<id>/...) get index.html with 200
    "not_found_handling": "single-page-application"
  },
  // Required by `npx wrangler preview` (non-main branches, e.g. uat). Empty is
  // fine: assets and compatibility settings above apply to Previews too.
  "previews": {}
}
