# Edge Function secrets. Copy to backend/functions/.env for `supabase start`
# (git-ignored), and set them in production with:
#     node backend/scripts/supabase.mjs secrets set --env-file backend/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically; do not set them here. None of these go in web/.

# Browser origins allowed to call join_trip / regenerate_invite (comma list;
# "https://*.<project>.pages.dev" covers Pages preview deployments).
ALLOWED_ORIGINS=http://localhost:5173,https://<project>.pages.dev,https://*.<project>.pages.dev,https://<custom-domain>

# FX vendor for fetch_fx_rates: openexchangerates | exchangerate-api | frankfurter
FX_PROVIDER=openexchangerates
FX_API_BASE=https://openexchangerates.org/api
FX_API_KEY=

# Shared secrets; must equal the Vault secrets cron_secret / push_webhook_secret
CRON_SECRET=
PUSH_WEBHOOK_SECRET=

# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys
# The public key also goes in web/.env.local as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# join_trip rate limit (failed code/token lookups per window)
JOIN_RATE_LIMIT_MAX_FAILURES=10
JOIN_RATE_LIMIT_MAX_FAILURES_PER_IP=30
JOIN_RATE_LIMIT_WINDOW_MINUTES=15
# Optional HMAC key for hashing client IPs (defaults to the service role key)
JOIN_RATE_LIMIT_SALT=
