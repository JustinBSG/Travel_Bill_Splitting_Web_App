# Live end-to-end test settings. Copy to backend/node-tests/.env.live (git-ignored).
#
# Local stack: `node backend/scripts/supabase.mjs status -o env` prints the
# URL and keys (API_URL, ANON_KEY, SERVICE_ROLE_KEY).
# Staging project: Dashboard > Project Settings > API keys. NEVER point this
# at production: the suite creates users and a trip (and deletes them after).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for any URL that is not localhost / 127.0.0.1
LIVE_ALLOW_REMOTE=0

# Optional: send_push accepts the webhook secret
PUSH_WEBHOOK_SECRET=

# Optional: with LIVE_RUN_FX=1, fetch_fx_rates is called for real (uses your FX vendor quota)
CRON_SECRET=
LIVE_RUN_FX=0

# Optional: an origin listed in the functions' ALLOWED_ORIGINS, for the CORS check
LIVE_ALLOWED_ORIGIN=

# Test users are e2e-<run>-<name>@<domain>; no email is ever sent
LIVE_EMAIL_DOMAIN=example.com

# Must equal the functions' JOIN_RATE_LIMIT_MAX_FAILURES
LIVE_JOIN_MAX_FAILURES=10
